{
  "name": "chess-multiplayer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "engine:sync": "node scripts/sync-stockfish.mjs",
    "assets": "node scripts/gen-sounds.mjs && node scripts/gen-icons.mjs",
    "prebuild": "node scripts/sync-stockfish.mjs && node scripts/gen-sounds.mjs && node scripts/gen-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "chess.js": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "embedded-postgres": "^17.10.0-beta.17",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
