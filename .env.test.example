# Copy to `.env.test` (git-ignored) and fill in with a DEDICATED TEST project.
#
# The e2e suite creates anonymous users, games, lobby rows and rating rows, so
# it refuses to run unless these point at a test backend — and it refuses
# outright if any value references the production project ref.
#
# Recommended: a second free Supabase project ("chess-multiplayer-test").
#   supabase projects create chess-multiplayer-test --org-id <org> --db-password <pw>
#   supabase link --project-ref <test-ref>          # or pass --project-ref below
#   supabase config push --project-ref <test-ref>   # enables anonymous sign-ins
#   supabase db push --db-url "postgresql://postgres.<test-ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#   supabase functions deploy game-create game-join game-action report --project-ref <test-ref>
#
# Public API URL of the test project:
FC_TEST_SUPABASE_URL=https://<test-ref>.supabase.co

# Public anon key of the test project (used by the app under test):
FC_TEST_SUPABASE_ANON_KEY=<anon key>

# Cleanup credentials — provide at least one of the two:
# preferred: a Postgres connection string (session pooler), used by global teardown
FC_TEST_DB_URL=postgresql://postgres.<test-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# alternative: the service_role key, used by the REST/admin-API teardown path
# FC_TEST_SERVICE_KEY=<service_role key>

# Optional: point the read-only production smoke spec at a different site
# FC_PROD_SITE_URL=https://<your-domain>
